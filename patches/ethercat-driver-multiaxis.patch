+  plugin_->secondary_axis_enabled_ = true;
+  plugin_->secondary_cia402_object_index_offset_ = 0x0800;
+  plugin_->secondary_mode_of_operation_ = 9;
+  plugin_->is_operational_ = true;
+  ASSERT_TRUE(plugin_->setup_from_config(YAML::Load(secondary_config)));
+  plugin_->setup_interface_mapping();
+
+  uint8_t status_address[2];
+  EC_WRITE_U16(status_address, 0x0040);  // Switch on disabled.
+  plugin_->processData(2, status_address);
+  uint8_t mode_display_address[1];
+  EC_WRITE_S8(mode_display_address, 9);
+  plugin_->processData(3, mode_display_address);
+  ASSERT_EQ(plugin_->secondary_state_, STATE_SWITCH_ON_DISABLED);
+  ASSERT_EQ(plugin_->secondary_mode_of_operation_display_, 9);
