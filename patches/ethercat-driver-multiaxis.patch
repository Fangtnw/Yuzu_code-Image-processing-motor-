+TEST_F(EcCiA402DriveTest, ShiftedAxisStatuswordUsesConfiguredOffset)
+{
+  std::string shifted_config(test_drive_config);
+  const std::vector<std::pair<std::string, std::string>> replacements = {
+    {"0x607a", "0x687a"}, {"0x60ff", "0x68ff"},
+    {"0x6071", "0x6871"}, {"0x6072", "0x6872"},
+    {"0x6040", "0x6840"}, {"0x6060", "0x6860"},
+    {"0x6064", "0x6864"}, {"0x606c", "0x686c"},
+    {"0x6077", "0x6877"}, {"0x6041", "0x6841"},
+    {"0x6061", "0x6861"},
+  };
+  for (const auto & replacement : replacements) {
+    size_t position = 0;
+    while ((position = shifted_config.find(replacement.first, position)) != std::string::npos) {
+      shifted_config.replace(position, replacement.first.size(), replacement.second);
+      position += replacement.second.size();
+    }
+  }
+
+  plugin_->cia402_object_index_offset_ = 0x0800;
+  ASSERT_TRUE(plugin_->setup_from_config(YAML::Load(shifted_config)));
+  plugin_->setup_interface_mapping();
+  uint8_t domain_address[2];
+  EC_WRITE_U16(domain_address, 0x0027);  // Operation enabled.
+  plugin_->processData(9, domain_address);  // Shifted statusword 0x6841.
+  plugin_->processData(12, domain_address);  // Final PDO entry updates state.
+  ASSERT_EQ(plugin_->status_word_, 0x0027);
+  ASSERT_EQ(plugin_->state_, STATE_OPERATION_ENABLED);
+}
+
+TEST_F(EcCiA402DriveTest, CspStartupGateHoldsFeedbackUntilCommandMatches)
+{
+  std::vector<double> command_interface = {0.0};
+  plugin_->command_interface_ptr_ = &command_interface;
+  plugin_->parameters_["command_interface/position"] = "0";
+  ASSERT_TRUE(plugin_->setup_from_config(YAML::Load(test_drive_config)));
+  plugin_->setup_interface_mapping();
+  plugin_->mode_of_operation_display_ = 8;
+  plugin_->last_position_ = 15.0;
+  plugin_->position_startup_tolerance_ = 0.1;
+
+  uint8_t domain_address[4];
+  EC_WRITE_S32(domain_address, 0);
+  plugin_->processData(0, domain_address);
+  ASSERT_FALSE(plugin_->position_command_synchronized_);
+  ASSERT_EQ(EC_READ_S32(domain_address), 15);
+
+  command_interface[0] = 15.0;
+  plugin_->processData(0, domain_address);
+  ASSERT_TRUE(plugin_->position_command_synchronized_);
+  ASSERT_EQ(EC_READ_S32(domain_address), 15);
+}
