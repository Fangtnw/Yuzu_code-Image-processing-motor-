<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_axis2_tiny_spin">
  <link name="axis2_base"/>
  <link name="axis2_output"/>

  <joint name="axis2_joint" type="continuous">
    <parent link="axis2_base"/>
    <child link="axis2_output"/>
    <axis xyz="0 0 1"/>
    <!-- Official output maximum is 416 rpm; commissioning is capped at 25 rpm. -->
    <limit velocity="43.563418" effort="0.7"/>
  </joint>

  <ros2_control name="AZD3A_axis2_tiny_spin" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">200</param>
      <param name="number_of_physical_drives">1</param>
    </hardware>

    <joint name="axis2_joint">
      <!-- +/-2.617993878 rad/s = +/-25 rpm commissioning boundary. -->
      <command_interface name="velocity">
        <param name="min">-2.6179938779914944</param>
        <param name="max">2.6179938779914944</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>

      <ec_module name="azd3a_axis2">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <!-- AZD3A Axis 2 CiA 402 objects are Axis 1 indices + 0x0800. -->
        <param name="cia402_object_index_offset">0x0800</param>
        <param name="mode_of_operation">9</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_axis2_tiny_spin_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
