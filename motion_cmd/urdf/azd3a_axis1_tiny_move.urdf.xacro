<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_axis1_tiny_move">
  <!--
    Axis 1 motion test. Unlike the feedback-only URDF, EcCiA402Drive
    automatically transitions the drive to Operation Enabled. Its CSP startup
    behavior holds the last measured position until a controller command arrives.
  -->
  <link name="axis1_base"/>
  <link name="axis1_table"/>

  <joint name="axis1_joint" type="prismatic">
    <parent link="axis1_base"/>
    <child link="axis1_table"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.000" upper="0.029" velocity="0.001" effort="40.0"/>
  </joint>

  <ros2_control name="AZD3A_axis1_tiny_move" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">100</param>
      <param name="number_of_physical_drives">1</param>
    </hardware>

    <joint name="axis1_joint">
      <command_interface name="position">
        <param name="min">0.000</param>
        <param name="max">0.029</param>
      </command_interface>
      <state_interface name="position"/>

      <ec_module name="azd3a_axis1">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="mode_of_operation">8</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_ked_cia402_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
