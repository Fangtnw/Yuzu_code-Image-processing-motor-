<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_axis3_index">
  <link name="axis3_base"/>
  <link name="axis3_output"/>
  <joint name="axis3_joint" type="continuous">
    <parent link="axis3_base"/>
    <child link="axis3_output"/>
    <axis xyz="0 0 1"/>
    <limit velocity="2.0943951023931953" effort="0.7"/>
  </joint>
  <ros2_control name="AZD3A_axis3_index" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">200</param>
      <param name="number_of_physical_drives">1</param>
    </hardware>
    <joint name="axis3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <ec_module name="azd3a_axis3">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="cia402_object_index_offset">0x1000</param>
        <!-- One count tolerance prevents a retained-position startup jump. -->
        <param name="position_startup_tolerance">0.000032</param>
        <param name="mode_of_operation">8</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_axis3_index_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
