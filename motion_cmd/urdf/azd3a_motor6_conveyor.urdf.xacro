<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_motor6_conveyor">
  <link name="base_link"/>
  <link name="slave0_keepalive_link"/>
  <link name="motor6_output"/>

  <joint name="slave0_keepalive_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="slave0_keepalive_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" velocity="1.0" effort="1.0"/>
  </joint>
  <joint name="motor6_joint" type="continuous">
    <parent link="base_link"/>
    <child link="motor6_output"/>
    <axis xyz="0 0 1"/>
    <!-- AZM46AK-PS50 permissible gearbox-output speed: 60 rpm. -->
    <limit velocity="6.283185307179586" effort="3.0"/>
  </joint>

  <ros2_control name="AZD3A_motor6_conveyor" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">200</param>
      <param name="number_of_physical_drives">2</param>
    </hardware>

    <joint name="slave0_keepalive_joint">
      <state_interface name="position"/>
      <ec_module name="azd3a_slave0_passive_keepalive">
        <plugin>ethercat_generic_plugins/GenericEcSlave</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_slave0_passive_keepalive.yaml</param>
      </ec_module>
    </joint>

    <joint name="motor6_joint">
      <command_interface name="velocity">
        <!-- Guarded commissioning launch is limited to +/-50 rpm. -->
        <param name="min">-5.235987755982989</param>
        <param name="max">5.235987755982989</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <ec_module name="azd3a_slave1_axis3_motor6">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">1</param>
        <param name="cia402_object_index_offset">0x1000</param>
        <param name="mode_of_operation">9</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_motor6_conveyor_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
