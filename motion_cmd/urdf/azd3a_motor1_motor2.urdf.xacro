<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_motor1_motor2_motor4_motor6">
  <link name="base_link"/>
  <link name="motor1_table"/>
  <link name="motor4_table"/>

  <!--
    One composite ros2_control joint represents three internal axes of the same
    physical AZD3A slave: position is Motor 1, velocity is Motor 2, and the
    custom motor3_position interface is Motor 3. This keeps one EtherCAT slave
    instance while allowing each axis to be claimed by a separate controller.
  -->
  <joint name="motor1_motor2" type="prismatic">
    <parent link="base_link"/>
    <child link="motor1_table"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.400" velocity="0.015" effort="43.0"/>
  </joint>

  <joint name="motor4_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="motor4_table"/>
    <axis xyz="1 0 0"/>
    <!-- Tiny negative margin accepts the retained ABZO origin (-0.0034 mm). -->
    <limit lower="-0.00001" upper="0.030" velocity="0.008" effort="10.0"/>
  </joint>

  <ros2_control name="AZD3A_motor1_motor2" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">200</param>
      <param name="number_of_physical_drives">2</param>
    </hardware>

    <joint name="motor1_motor2">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.400</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-26.179938779914945</param>
        <param name="max">26.179938779914945</param>
      </command_interface>
      <command_interface name="motor3_position">
        <param name="min">0.0</param>
        <param name="max">0.020</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="motor3_position"/>
      <state_interface name="motor1_status"/>
      <state_interface name="motor2_status"/>
      <state_interface name="motor3_status"/>

      <ec_module name="azd3a_motor1_motor2">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="mode_of_operation">8</param>
        <param name="position_startup_tolerance">0.00001</param>
        <param name="secondary_cia402_object_index_offset">0x0800</param>
        <param name="secondary_mode_of_operation">9</param>
        <param name="tertiary_cia402_object_index_offset">0x1000</param>
        <param name="tertiary_mode_of_operation">8</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_motor1_motor2_slave.yaml</param>
      </ec_module>
    </joint>

    <joint name="motor4_joint">
      <command_interface name="position">
        <!-- GUI/guard commands remain 0..20 mm; this is startup margin only. -->
        <param name="min">-0.00001</param>
        <param name="max">0.020</param>
      </command_interface>
      <command_interface name="velocity">
        <!-- Motor 6 conveyor: guarded to +/-50 output rpm. -->
        <param name="min">-5.235987755982989</param>
        <param name="max">5.235987755982989</param>
      </command_interface>
      <command_interface name="motor5_position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="motor5_position"/>
      <state_interface name="motor6_position"/>
      <state_interface name="motor4_status"/>
      <state_interface name="motor5_status"/>
      <state_interface name="motor6_status"/>

      <ec_module name="azd3a_slave1_axis1_motor4">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">1</param>
        <!--
          The Motor 4 application guard owns startup synchronization: it
          follows live feedback until the first operator command and rejects
          commands before feedback exists. Do not enable the plugin's finite
          startup latch here; concurrent controller startup can leave that
          latch permanently overriding valid guarded commands.
        -->
        <param name="mode_of_operation">8</param>
        <param name="secondary_cia402_object_index_offset">0x1000</param>
        <param name="secondary_mode_of_operation">9</param>
        <param name="tertiary_cia402_object_index_offset">0x0800</param>
        <param name="tertiary_mode_of_operation">8</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_motor4_motor6_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
