<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_axis3_tiny_spin">
  <link name="axis3_base"/>
  <link name="axis3_output"/>

  <joint name="axis3_joint" type="continuous">
    <parent link="axis3_base"/>
    <child link="axis3_output"/>
    <axis xyz="0 0 1"/>
    <!-- Official output maximum is 150 rpm; machine requirement is 20 rpm. -->
    <limit velocity="15.707963267948966" effort="0.7"/>
  </joint>

  <ros2_control name="AZD3A_axis3_tiny_spin" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">200</param>
      <param name="number_of_physical_drives">1</param>
    </hardware>

    <joint name="axis3_joint">
      <!-- +/-2.094395102 rad/s = +/-20 rpm machine requirement boundary. -->
      <command_interface name="velocity">
        <param name="min">-2.0943951023931953</param>
        <param name="max">2.0943951023931953</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>

      <ec_module name="azd3a_axis3">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="cia402_object_index_offset">0x1000</param>
        <param name="mode_of_operation">9</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_axis3_tiny_spin_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
