<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="azd3a_motor5_commissioning">
  <link name="motor5_base"/>
  <link name="motor5_output"/>
  <link name="slave0_keepalive_base"/>
  <link name="slave0_keepalive_output"/>

  <joint name="slave0_keepalive_mount" type="fixed">
    <parent link="motor5_base"/>
    <child link="slave0_keepalive_base"/>
  </joint>
  <joint name="slave0_keepalive_joint" type="prismatic">
    <parent link="slave0_keepalive_base"/>
    <child link="slave0_keepalive_output"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" velocity="1.0" effort="1.0"/>
  </joint>
  <joint name="motor5_joint" type="continuous">
    <parent link="motor5_base"/>
    <child link="motor5_output"/>
    <axis xyz="0 0 1"/>
    <limit velocity="2.0943951023931953" effort="0.7"/>
  </joint>

  <ros2_control name="AZD3A_motor5_commissioning" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">200</param>
      <param name="number_of_physical_drives">2</param>
    </hardware>
    <joint name="slave0_keepalive_joint">
      <state_interface name="position"/>
      <ec_module name="azd3a_slave0_passive_keepalive">
        <plugin>ethercat_generic_plugins/GenericEcSlave</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_slave0_passive_keepalive.yaml</param>
      </ec_module>
    </joint>
    <joint name="motor5_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <ec_module name="azd3a_slave1_axis2_motor5">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">1</param>
        <param name="cia402_object_index_offset">0x0800</param>
        <!-- Approximately one encoder count at 200,000 counts/revolution. -->
        <param name="position_startup_tolerance">0.000032</param>
        <param name="mode_of_operation">8</param>
        <param name="slave_config">$(find motor_controller)/config/azd3a_motor5_commissioning_slave.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>
</robot>
